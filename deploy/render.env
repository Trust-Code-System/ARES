# ============================================================================
# ARES — importable environment for the Render API service (and scheduler worker)
# ============================================================================
# HOW TO USE
#   Render dashboard → your service → Environment → "Add from .env" → paste this
#   file's contents (or upload it). Then replace every CHANGE_ME with a real value.
#   The same set works for both ares-api and ares-scheduler.
#
# NOTE on REDIS_URL: when you deploy via render.yaml (Blueprint), REDIS_URL is
#   wired automatically from the managed Redis — do NOT set it here or you'll
#   override it. Only uncomment it at the bottom if you are NOT using the blueprint.
#
# Lines you MUST fill are marked  # >>> REQUIRED.  Everything else has a working
# default or is an optional capability you can enable later.
# ============================================================================

# ── Reasoning provider ──────────────────────────────────────────────────────
ARES_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=CHANGE_ME            # >>> REQUIRED (sk-ant-...). Also powers image OCR.
ARES_REASONING_MODEL=claude-opus-4-8
ARES_FAST_MODEL=claude-sonnet-4-6

# ── HTTP control plane + auth ───────────────────────────────────────────────
# Generate: openssl rand -base64 32   (must be >= 16 chars)
ARES_API_KEY=CHANGE_ME                 # >>> REQUIRED — server refuses non-loopback bind without it.
# Bind publicly inside the container; guarded by ARES_API_KEY above.
ARES_API_HOST=0.0.0.0
ARES_API_PORT=3001
# Browser CORS allowlist = your Vercel URL(s). Comma-separated, NO trailing slash.
ARES_API_ORIGINS=https://your-app.vercel.app   # >>> REQUIRED — set to your real Vercel URL.
ARES_SESSION_TTL_HOURS=12

# ── Memory: Postgres (pgvector) + embeddings ────────────────────────────────
# Supabase → Project Settings → Database → Connection string (or Render Postgres
# with the pgvector extension enabled). Unset → in-memory (data lost on restart).
DATABASE_URL=CHANGE_ME                 # >>> REQUIRED for persistent memory.
# Embeddings: with neither key ARES uses an offline hash embedder (poor recall).
# VOYAGE_API_KEY=CHANGE_ME             # recommended (voyage-3.5, 1024-dim)
ARES_EMBEDDING_PROVIDER=auto
ARES_EMBEDDING_MODEL=voyage-3.5
ARES_EMBEDDING_DIM=1024

# ── Agent loop + safety gate ────────────────────────────────────────────────
ARES_MAX_ITERATIONS=12
# prompt = state-mutating actions queue for approval in the web UI (correct for prod).
ARES_CONFIRMATION_MODE=prompt

# ── Tools / sandbox ─────────────────────────────────────────────────────────
# Must match the Render disk mount path in render.yaml.
ARES_WORKSPACE_DIR=/data/workspace
# python3 is installed in the image; backs the run_python tool (confirmation-gated).
ARES_PYTHON_ENABLED=true
# Desktop/system control — off on a headless server.
ARES_SYSTEM_ACTIONS_ENABLED=false
# Vendored skill + agent libraries ship in the image; leave enabled.
ARES_SKILLS_ENABLED=true
ARES_AGENTS_ENABLED=true

# ── Optional capabilities (uncomment + fill to enable) ──────────────────────
# Extra providers (fallback reasoning, voice, image gen, Google search/embeddings):
# OPENAI_API_KEY=CHANGE_ME
# GEMINI_API_KEY=CHANGE_ME
# Web search (web_search tool). Google is auto-preferred when GEMINI_API_KEY is set.
# TAVILY_API_KEY=CHANGE_ME
ARES_SEARCH_PROVIDER=auto
# GitHub dev tools (github_search/github_read_file/github_create_issue):
# GITHUB_TOKEN=CHANGE_ME

# Email: draft_email is always on; sending needs these + ARES_EMAIL_ENABLED=true.
# ARES_EMAIL_ENABLED=true
# ARES_SMTP_HOST=smtp.gmail.com
# ARES_SMTP_PORT=587
# ARES_SMTP_SECURE=false
# ARES_SMTP_USER=you@gmail.com
# ARES_SMTP_PASS=your-app-password
# ARES_EMAIL_FROM=you@gmail.com

# Headless browser (browser_* tools). Requires adding `npx playwright install
# chromium` to the Dockerfile — NOT bundled by default.
# ARES_BROWSER_ENABLED=true
# ARES_BROWSER_HEADLESS=true

# Voice (used by the scheduler/HUD). auto-resolves from the keys you set above.
# ARES_VOICE_STT_PROVIDER=auto
# ARES_VOICE_TTS_PROVIDER=auto
# ELEVENLABS_API_KEY=CHANGE_ME
# ELEVENLABS_VOICE_ID=CHANGE_ME

# Scheduler worker only: enable the inbound webhook trigger layer.
# ARES_WEBHOOK_SECRET=CHANGE_ME

# Durable scheduler/queue. LEAVE COMMENTED when deploying via render.yaml
# (the Blueprint injects it from the managed Redis). Set it only for a manual,
# non-blueprint deploy:
# REDIS_URL=redis://red-xxxxx:6379
