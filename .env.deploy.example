# Deploy-only settings to ADD to your existing .env on the VPS.
# Your current .env already has ARES_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY,
# and DATABASE_URL — keep those. Add the lines below.

# Your domain (DNS A-records for BOTH the apex/host and the api. subdomain must
# point at this server). Compose reads this for routing + the web build arg.
ARES_DOMAIN=ares.example.com

# These are also set per-service in docker-compose.yml, but listing them keeps
# `npm run serve` behaving the same if you ever run the API outside compose:
# REDIS_URL=redis://dragonfly:6379
# ARES_API_HOST=0.0.0.0
# ARES_API_ORIGINS=https://ares.example.com

# NOTE: DATABASE_URL must be reachable FROM the container (a managed/remote
# Postgres with the `vector` extension, e.g. Supabase). A "localhost" URL from
# your laptop will NOT resolve inside Docker.
