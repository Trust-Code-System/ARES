# ARES environment configuration
# Copy to .env and fill in. Never commit .env.

# --- Reasoning provider ---
# Select the main agent provider. All providers use the same tool gate and audit loop.
ARES_LLM_PROVIDER=anthropic

# Anthropic (required when ARES_LLM_PROVIDER=anthropic).
# Also powers image OCR (the extract_image_text document tool) via Claude vision,
# even when another provider drives reasoning. Without it, image OCR is disabled.
ANTHROPIC_API_KEY=sk-ant-...

# Model selection (optional — these are the defaults baked into the code)
# Reasoning / orchestration model:
ARES_REASONING_MODEL=claude-opus-4-8
# High-frequency / cheap model for routine sub-tasks:
ARES_FAST_MODEL=claude-sonnet-4-6

# OpenAI (required when ARES_LLM_PROVIDER=openai; also enables voice below)
# Current OpenAI defaults use the Responses API.
# OPENAI_API_KEY=sk-...
ARES_OPENAI_REASONING_MODEL=gpt-5.5
ARES_OPENAI_FAST_MODEL=gpt-5.4-mini

# Gemini reasoning and Google-grounded search. Set ARES_LLM_PROVIDER=gemini to
# use Gemini for the main agent. Search auto-prefers Google when this key exists.
# GEMINI_API_KEY=
ARES_GEMINI_REASONING_MODEL=gemini-3.5-flash
ARES_GEMINI_FAST_MODEL=gemini-3.1-flash-lite
ARES_SEARCH_PROVIDER=auto

# --- Agent loop ---
# Hard cap on tool-use round trips per run (safety guard against runaway loops).
# Must be an integer from 1 to 100.
ARES_MAX_ITERATIONS=12

# --- Confirmation gate ---
# auto  = approve every state-mutating action (dev only)
# deny  = reject every state-mutating action (read-only safe mode)
# prompt = ask on the terminal (interactive)
ARES_CONFIRMATION_MODE=prompt

# --- Phase 2: memory ---
# Postgres connection string (Supabase → Project Settings → Database → Connection string).
# If unset, ARES falls back to EPHEMERAL in-memory memory + audit (dev only).
# DATABASE_URL=postgresql://postgres:<pwd>@db.<ref>.supabase.co:5432/postgres

# Embeddings. Anthropic has no embeddings API and recommends Voyage AI.
# If unset, ARES uses an offline hash embedder (runnable, but poor recall).
# VOYAGE_API_KEY=
# Embedding model + dimension. ARES_EMBEDDING_DIM MUST match the vector(N) column
# in migrations/0001 (default 1024 for voyage-3.5). Change both together.
ARES_EMBEDDING_MODEL=voyage-3.5
ARES_EMBEDDING_DIM=1024

# --- Phase 3: tools ---
# Sandbox the file tools (read_file/write_file/list_files) are jailed to.
ARES_WORKSPACE_DIR=./workspace
# Tavily key for web_search (https://tavily.com). In auto mode, Gemini-backed
# Google search is preferred when GEMINI_API_KEY exists, otherwise Tavily is used.
# web_fetch needs no key.
# TAVILY_API_KEY=

# Confirmation-gated local execution and desktop control.
ARES_PYTHON_ENABLED=true
# ARES_PYTHON_COMMAND=python
# ARES_PYTHON_TIMEOUT_MS=15000
ARES_SYSTEM_ACTIONS_ENABLED=true

# Trading tools (off by default). Paper broker unless ARES_BROKER=alpaca.
# ARES_TRADING_ENABLED=false
# ARES_TRADING_PAPER_CASH=100000
# ARES_BROKER=paper
# Alpaca (required when ARES_BROKER=alpaca). Defaults to the PAPER endpoint;
# set ALPACA_BASE_URL to the live host only to trade real money.
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Phase 4+ (not used yet) ---
# REDIS_URL=

# --- API server + authentication ---
# Shared API key for the HTTP control plane (single-user auth). When set, every
# endpoint except /api/health and /api/auth/login requires it. The web dashboard
# exchanges it for a short-lived session token at login. REQUIRED to bind a
# non-loopback ARES_API_HOST — the server refuses to start otherwise.
# Generate one with: openssl rand -base64 32   (must be >= 16 chars)
# ARES_API_KEY=
# Session token lifetime in hours (default 12; range 0 < h <= 720).
# ARES_SESSION_TTL_HOURS=12
#
# API server defaults to loopback only. Origins are a comma-separated browser allowlist.
# ARES_API_HOST=127.0.0.1
# ARES_API_PORT=3001
# ARES_API_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OpenAI can provide both sides of /api/voice/* and acts as the auto fallback.
# Voice also works with Gemini STT plus ElevenLabs TTS when those keys are set.
# Overrides (defaults shown):
# ARES_VOICE_STT_MODEL=whisper-1
# ARES_VOICE_TTS_MODEL=tts-1
# ARES_VOICE_TTS_VOICE=alloy
# ARES_VOICE_TTS_FORMAT=mp3
# OPENAI_BASE_URL=https://api.openai.com/v1

# Voice routing. "auto" uses Gemini STT when GEMINI_API_KEY exists and
# ElevenLabs TTS when both ElevenLabs values exist; otherwise OpenAI is used.
ARES_VOICE_STT_PROVIDER=auto
ARES_VOICE_TTS_PROVIDER=auto
# ARES_GEMINI_STT_MODEL=gemini-3.1-flash-lite
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
